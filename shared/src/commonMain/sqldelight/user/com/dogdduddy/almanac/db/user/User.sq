-- user.db — 쓰기 가능. 기기 내부 저장소.
--
-- content.db 와 절대 합치지 않는다. 출시 후 매주 문장을 추가하는 계획이 있고,
-- 그때마다 content.db 는 통째로 교체되므로 히스토리를 거기 두면 유저 아카이브가 소실된다.
--
-- 이 파일은 유저 데이터를 담으므로 스키마 변경 시 반드시 .sqm 마이그레이션을 동반한다.

-- 설치 단위 정보. 행은 항상 하나다.
CREATE TABLE install (
    id            INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    -- 소문자 UUID v4. 시드 입력이므로 대소문자가 섞이면 문장이 갈라진다.
    install_id    TEXT    NOT NULL,
    created_at    INTEGER NOT NULL
);

-- 보유 팩. 무료 스타터도 여기 들어간다 (source = 'bundled').
-- 결제 상태를 진실의 원천으로 두지 않는다 — RevenueCat 이 원천이고 여기는 캐시다.
CREATE TABLE owned_packs (
    pack_id       TEXT    NOT NULL PRIMARY KEY,
    acquired_at   INTEGER NOT NULL,
    source        TEXT    NOT NULL  -- 'bundled' | 'purchase' | 'restore'
);

-- 표시 이력. 아카이브이자 히스토리 회피의 근거.
-- (날짜, 시간대, 위치) 로 유일하다 — 같은 슬롯을 여러 번 그려도 한 줄만 남는다.
--
-- **위젯도 여기에 쓴다.** 그래야 슬롯이 고정되고 위젯과 앱이 같은 문장을 그린다.
-- 다만 위젯이 그린 것과 유저가 앱에서 읽은 것은 다르므로 [read_at] 으로 구분한다.
CREATE TABLE daily_page (
    date          TEXT    NOT NULL,
    time_of_day   TEXT    NOT NULL,
    location_key  TEXT    NOT NULL,
    entry_id      INTEGER NOT NULL,
    weather_group TEXT    NOT NULL,
    wind_flag     INTEGER NOT NULL,
    shown_at      INTEGER NOT NULL,
    -- 유저가 **앱 화면에서** 이 슬롯을 본 시각. 위젯만 그렸으면 NULL.
    --
    -- 위젯 갱신까지 '읽음' 으로 세면 주머니 속에서 콘텐츠가 소진된다.
    -- 위젯은 잘린 티저이고 문장을 다 읽으려면 앱을 열어야 하므로, 소비의 기준은
    -- 앱에서 그린 것이다. 이 값이 균등 노출(readCounts)의 유일한 입력이다.
    read_at       INTEGER,
    PRIMARY KEY (date, time_of_day, location_key)
);

CREATE INDEX daily_page_recent ON daily_page (shown_at DESC);

-- 확정된 위치. 행은 항상 하나다.
--
-- **위젯이 이 값을 읽는다.** 위젯은 권한을 요청할 수도, GPS 측위를 기다릴 수도 없다.
-- 그래서 앱이 위치를 해결해 여기 저장하고 위젯은 조회만 한다.
-- 앱을 한 번도 안 열었으면 기본 도시가 들어간다 — 위젯이 빈 화면이 되면 안 된다.
CREATE TABLE saved_location (
    id            INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    latitude      REAL    NOT NULL,
    longitude     REAL    NOT NULL,
    -- 화면에 보여줄 이름. GPS 로 잡았으면 가장 가까운 도시 이름.
    label         TEXT    NOT NULL,
    -- 'gps' | 'manual' | 'default'
    -- manual 은 유저의 명시적 선택이므로 GPS 보다 우선한다.
    mode          TEXT    NOT NULL,
    updated_at    INTEGER NOT NULL
);

-- 날씨 캐시.
--
-- **소모품이다** — 지워져도 유저가 잃는 것이 없다. 그래도 user.db 에 두는 이유는
-- 앱과 위젯이 같은 파일을 열어 같은 캐시를 봐야 하기 때문이다. 위젯이 따로 캐시를
-- 가지면 라이선스가 요구하는 1시간 규칙이 사실상 30분이 된다.
--
-- 신선도 판단은 WeatherCachePolicy 가 한다. 이 테이블은 그 입력만 보관한다.
CREATE TABLE weather_cache (
    location_key  TEXT    NOT NULL PRIMARY KEY,
    wmo_code      INTEGER NOT NULL,
    wind_speed_ms REAL    NOT NULL,
    temperature_c REAL,
    observed_at   INTEGER NOT NULL,
    fetched_at    INTEGER NOT NULL,
    expires_at    INTEGER,
    -- 다음 요청의 If-Modified-Since 에 그대로 넣는 원문 헤더 값.
    last_modified TEXT,
    -- 연속 실패 횟수. 백오프 계산에 쓰고 성공하면 0 으로 되돌린다.
    failure_count INTEGER NOT NULL DEFAULT 0,
    failed_at     INTEGER
);

-- 일출·일몰 캐시. 날짜별로 하루 한 번만 받으면 된다.
-- 극야·극주에서는 sunrise/sunset 이 NULL 이며, 그것도 유효한 캐시 결과다
-- (매번 다시 물어보지 않도록 행을 남긴다).
CREATE TABLE sun_cache (
    location_key  TEXT    NOT NULL,
    date          TEXT    NOT NULL,
    sunrise_at    INTEGER,
    sunset_at     INTEGER,
    fetched_at    INTEGER NOT NULL,
    PRIMARY KEY (location_key, date)
);

-- ---------------------------------------------------------------------------
-- 쿼리
-- ---------------------------------------------------------------------------

selectInstall:
SELECT * FROM install WHERE id = 1;

insertInstall:
INSERT OR IGNORE INTO install (id, install_id, created_at) VALUES (1, ?, ?);

ownedPackIds:
SELECT pack_id FROM owned_packs ORDER BY pack_id;

grantPack:
INSERT OR REPLACE INTO owned_packs (pack_id, acquired_at, source) VALUES (?, ?, ?);

revokePack:
DELETE FROM owned_packs WHERE pack_id = ?;

-- PageSelector 의 recentlyShownIds 입력. **최신순**이어야 한다.
--
-- **지금 그리는 슬롯 자신은 제외한다.** 이 슬롯은 이미 기록돼 있을 수 있고,
-- 그 기록이 히스토리로 들어가면 방금 고른 문장이 다음 조회에서 자기 자신을
-- 후보에서 밀어낸다 — 같은 슬롯을 다시 열 때마다 문장이 뒤집힌다.
-- 결정론 계약이 깨지는 지점이므로 파라미터를 생략할 수 있게 두지 않는다.
recentEntryIdsExcludingSlot:
SELECT entry_id FROM daily_page
WHERE date <> :date OR time_of_day <> :timeOfDay OR location_key <> :locationKey
ORDER BY shown_at DESC LIMIT :limit;

-- 슬롯을 새 문장으로 확정한다. read_at 은 NULL 로 들어간다 —
-- 날씨가 바뀌어 문장이 교체된 것이므로 이전의 '읽음' 은 이 문장의 것이 아니다.
recordPage:
INSERT OR REPLACE INTO daily_page (
    date, time_of_day, location_key, entry_id, weather_group, wind_flag, shown_at, read_at
) VALUES (?, ?, ?, ?, ?, ?, ?, NULL);

-- 앱 화면이 이 슬롯을 그렸다. 이미 읽은 슬롯이면 시각을 덮지 않는다 —
-- 하루에 앱을 열 번 열어도 그 문장을 열 번 읽은 것은 아니다.
markSlotRead:
UPDATE daily_page SET read_at = :readAt
WHERE date = :date AND time_of_day = :timeOfDay AND location_key = :locationKey
  AND read_at IS NULL;

-- 문장별 '읽은 슬롯 수'. 균등 노출의 입력이다.
-- 위젯만 그린 슬롯(read_at IS NULL)은 여기 잡히지 않는다.
readCounts:
SELECT entry_id, COUNT(*) AS read_count FROM daily_page
WHERE read_at IS NOT NULL
GROUP BY entry_id;

pageFor:
SELECT * FROM daily_page
WHERE date = :date AND time_of_day = :timeOfDay AND location_key = :locationKey;

-- 최신순. time_of_day 는 문자열 정렬이 시간순과 다르므로(morning > evening_night > day)
-- 슬롯 순서를 명시한다. 안 그러면 같은 날 안에서 아침 페이지가 저녁 앞에 온다.
archive:
SELECT * FROM daily_page
ORDER BY date DESC,
    CASE time_of_day WHEN 'evening_night' THEN 2 WHEN 'day' THEN 1 ELSE 0 END DESC
LIMIT :limit OFFSET :offset;

archiveCount:
SELECT COUNT(*) FROM daily_page;

-- ---- 위치 ----

savedLocation:
SELECT * FROM saved_location WHERE id = 1;

upsertLocation:
INSERT OR REPLACE INTO saved_location (id, latitude, longitude, label, mode, updated_at)
VALUES (1, ?, ?, ?, ?, ?);

-- ---- 날씨 캐시 ----

weatherFor:
SELECT * FROM weather_cache WHERE location_key = :locationKey;

upsertWeather:
INSERT OR REPLACE INTO weather_cache (
    location_key, wmo_code, wind_speed_ms, temperature_c, observed_at,
    fetched_at, expires_at, last_modified, failure_count, failed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, NULL);

-- 304 응답. 본문이 없으니 값은 그대로 두고 신선도만 갱신한다.
touchWeatherFreshness:
UPDATE weather_cache
SET fetched_at = :fetchedAt, expires_at = :expiresAt, last_modified = :lastModified,
    failure_count = 0, failed_at = NULL
WHERE location_key = :locationKey;

recordWeatherFailure:
UPDATE weather_cache
SET failure_count = failure_count + 1, failed_at = :failedAt
WHERE location_key = :locationKey;

-- ---- 일출·일몰 캐시 ----

sunFor:
SELECT * FROM sun_cache WHERE location_key = :locationKey AND date = :date;

upsertSun:
INSERT OR REPLACE INTO sun_cache (location_key, date, sunrise_at, sunset_at, fetched_at)
VALUES (?, ?, ?, ?, ?);

pruneSunCache:
DELETE FROM sun_cache WHERE date < :beforeDate;
