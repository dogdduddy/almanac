<?xml version="1.0" encoding="utf-8" ?>
<!--
  스파이크 3단계: 검토에서 지적된 미검증 경로 확인.

  S. SpannableString + TypefaceSpan(Typeface)  (API 28+)  → setTextViewText
  T. setTextViewTextAppearance + @font 를 품은 style
  Q. 기본 폰트 (기준선)
  R. 비트맵 (Crimson 실물 — 성공이 어떻게 보이는지의 기준)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/label_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF999999"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/text_span"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF111111"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/label_t"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#FF999999"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/text_appearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF111111"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/label_q"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#FF999999"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/text_default_font"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF111111"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/label_r"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#FF999999"
        android:textSize="9sp" />

    <ImageView
        android:id="@+id/image_bitmap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/spike_sample_text"
        android:scaleType="fitStart" />

    <TextView
        android:id="@+id/label_diag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#FF444444"
        android:textSize="10sp" />

</LinearLayout>
